{
    "name": "horde/sessionhandler",
    "description": "Session handler library",
    "type": "horde-library",
    "homepage": "https://www.horde.org/libraries/Horde_SessionHandler",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "sessions",
        "sessionless_sessions"
    ],
    "time": "2026-06-30",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "dev-FRAMEWORK_6_0 || ^3 || ^2",
        "php": "^8",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/support": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/db": "^3 || dev-FRAMEWORK_6_0",
        "horde/hashtable": "^2 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "horde/mongo": "^2 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/db": "^3 || dev-FRAMEWORK_6_0",
        "horde/hashtable": "^2 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0",
        "horbde/mongo": "^2"
    },
    "autoload": {
        "psr-0": {
            "Horde_SessionHandler": "lib/"
        },
        "psr-4": {
            "Horde\\SessionHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\SessionHandler\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}